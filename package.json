{
  "name": "@cihatsarsilmaz/citv-slot",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "CITV Slot — 18 salon, karakter sahneleri, keçe kasa.",
  "author": "cihatsarsilmaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cihatsarsilmaz/citvapp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.mjs",
    "audit:citv": "node scripts/audit.mjs",
    "tetikci": "node scripts/tetikci.mjs",
    "build": "node scripts/tetikci.mjs && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "sim": "node src/sim.js",
    "lint": "echo 'Lint configured'",
    "test": "node --test tests/*.test.mjs && node scripts/tetikci.mjs",
    "deploy:vercel": "npm run build && npx vercel --prod",
    "deploy:netlify": "npm run build && npx netlify-cli deploy --prod --dir=dist",
    "deploy:gh": "npm run build && npx gh-pages -d dist",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && (test -d android || npx cap add android) && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "citv-slot",
    "slot",
    "react",
    "vite"
  ],
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.1"
  },
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  }
}
