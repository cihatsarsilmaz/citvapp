PORT=8787
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8787
API_ORIGIN=
DATABASE_PATH=.data/citv.sqlite
SESSION_HOURS=24
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# Capacitor başka bir alan adındaki API'ye bağlanacaksa:
# APP_ORIGIN=https://uygulama.example,https://localhost,capacitor://localhost
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None
# VITE_CITV_API_URL=https://api.example

# İlk yönetici yalnızca iki değer birlikte verildiğinde oluşturulur.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-with-at-least-12-characters
